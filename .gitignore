node_modules/
build/
dist/
*.js.map
.env
.DS_Store

# Local planning docs (not for the repo)
.claude/plans/

# Image data and run outputs: heavy and machine-local, never in the repo.
data/**
# ...but keep the text ledger. These are what references/library.json cites as provenance,
# so an entry whose RUNLOG or op list is untracked is an entry nobody else can verify.
!data/**/
!data/SCOREBOARD.md
!data/**/RUNLOG.md
!data/**/variants/*.js
# An entry's metrics are DERIVED from its profiler json and its op list, so those two are part of
# the provenance, not run scratch: without them an entry cannot be re-derived or audited.
!data/**/oplists.json
!data/**/apply-ops.js
!data/**/profile_*.json
!data/**/meta_*.json
# The pre-v2 archive stays out entirely: input-only, and its markdown records a dead pipeline.
data/_pre-v2/**

# Generated per-build by module/build.mjs
module/src/BuildTimestamp.h

# 本地产物只发布到独立分发分支，不混入源码分支。
pi-repo/

# 签名密钥不得提交；.xsgn 是公开签名，但只随分发产物发布。
*.xssk
signing-key.json
*.xsgn
